# ---------------------------------------------------------------- key material
#
# This is a public repository. Nothing that can hold a mnemonic or a private key
# belongs in it, so the wallet's own storage and everything the export commands
# write are ignored by name.

# A wallet home, wherever it lands.
.causewaybaywallet/
**/accounts.jsonl
**/config.jsonl
**/history.jsonl
**/recent.jsonl

# What `account list --format` and the TUI's save/export commands write. The
# default filenames are matched explicitly; a file named for its contents is
# still your responsibility to keep out.
wallets.jsonl
wallets.csv
wallets.txt
wallets.md
wallets-keys.jsonl
*.demo-home/

# `account list --format` writes jsonl, csv, txt or md, and `-o` takes any
# path — so the name-based patterns cover all four rather than only the one
# they started with. Anything holding key material under a name not matched
# here is still your responsibility to keep out.
*-keys.jsonl
*-keys.csv
*-keys.txt
*-keys.md
*secret*.jsonl
*secret*.csv
*secret*.txt

# ------------------------------------------------------------- build artefacts
/dist/

# --------------------------------------------------------------- editor and OS
.DS_Store
.idea/
.vscode/
*.swp

# Language-specific artefacts are ignored in rustcli/ and pythoncli/.
